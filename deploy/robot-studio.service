[Unit]
Description=Robot Studio static showcase
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/robot-studio/current
Environment=NODE_ENV=production
Environment=PORT=80
ExecStart=/usr/bin/node /opt/robot-studio/current/deploy/server.mjs
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
