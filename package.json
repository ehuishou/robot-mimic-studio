{
  "name": "robot-mimic-studio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run prepare:pose && npm run typecheck && npm run build:relay && vite build",
    "build:relay": "esbuild server/relay.ts --bundle --platform=node --format=esm --packages=external --outfile=deploy/runtime/relay.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "prepare:pose": "node scripts/prepare-pose-assets.mjs",
    "generate:model": "node scripts/generate-robot-glb.mjs",
    "test:pose": "node scripts/verify-pose-browser.mjs",
    "test:retarget": "node scripts/verify-retarget-browser.mjs",
    "test:full-body": "tsx scripts/verify-full-body-browser.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
