{
  "name": "robot-mimic-studio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run prepare:pose && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "prepare:pose": "node scripts/prepare-pose-assets.mjs",
    "test:pose": "node scripts/verify-pose-browser.mjs",
    "test:retarget": "node scripts/verify-retarget-browser.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
